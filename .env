# Google Play Billing Configuration
# Get service account JSON from Google Cloud Console, convert to Base64
# On Linux/Mac: cat service-account-key.json | base64 -w 0
# On Windows PowerShell: [Convert]::ToBase64String([System.IO.File]::ReadAllBytes("service-account-key.json"))
GOOGLE_PLAY_SERVICE_ACCOUNT_

# PayPal Configuration
# Get from PayPal Developer Dashboard -> Apps & Credentials
PAYPAL_MODE=sandbox
# PAYPAL_CLIENT_ID=your-client-id
# PAYPAL_CLIENT_SECRET=your-client-secret

# Google Play Billing V2 Configuration
# Required: GOOGLE_PLAY_PACKAGE_NAME must be set to com.vpn.flyvpn
# Credentials priority: GOOGLE_PLAY_SERVICE_ACCOUNT_KEY (Base64) > GOOGLE_PLAY_SERVICE_ACCOUNT_KEY_PATH (file)
GOOGLE_PLAY_BILLING_ENABLED=true
GOOGLE_PLAY_PACKAGE_NAME=com.vpn.flyvpn
# GOOGLE_PLAY_SERVICE_ACCOUNT_KEY_PATH=/path/to/service-account-key.json