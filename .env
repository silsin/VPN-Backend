# Config health — Tier-2 traffic smoke test
# Xray is auto-downloaded into ./bin/xray on startup (no manual install needed)
XRAY_AUTO_INSTALL=true
# Optional: pin version e.g. v26.6.27 — leave empty to use newest GitHub release
# XRAY_VERSION=
# Optional override absolute path (skip auto-install if this binary works)
# XRAY_BIN=
# XRAY_INSTALL_DIR=   # default: <cwd>/bin/xray
CONFIG_TRAFFIC_CHECK_ENABLED=true
CONFIG_TRAFFIC_CHECK_CONCURRENCY=2
CONFIG_TRAFFIC_TIMEOUT_MS=15000
# Must be http:// (not https) — probe uses raw HTTP over SOCKS
CONFIG_TRAFFIC_DOWNLOAD_URL=http://www.gstatic.com/generate_204
CONFIG_TRAFFIC_UPLOAD_URL=http://speed.cloudflare.com/__up
